# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Large artefacts — never commit datasets or checkpoints
data/raw/
data/processed/*.bin
data/processed/*.jsonl
data/processed/tokenizer_corpus.txt
checkpoints/*/
checkpoints/**/*.pt
checkpoints/**/*.json
# training logs ARE deliverables (small) -> keep logs/*.jsonl and logs/*.log
# only ignore throwaway scratch logs
logs/*.tmp
logs/scratch*

# keep directory structure
!checkpoints/.gitkeep
!logs/.gitkeep
!reports/.gitkeep

.DS_Store
.env

# autopilot --self-test scratch artefacts (regenerated on demand)
data/_selftest/
configs/_selftest.yaml
configs/_selftest_model.yaml

# autopilot runtime outputs (generated on the user's Colab, never committed)
reports/autopilot_config_choice.json
reports/autopilot_pilot_verification.json
reports/autopilot_summary.md
configs/_autogen_*.yaml
reports/autopilot_error.txt
reports/autopilot_pilot_attempts.json
reports/autopilot_train_status.json
reports/autopilot_resume_test.json
notebooks/ANKIT_LLM_ONE_CLICK_T4_v3.ipynb
drive_upload/
notebooks/ANKIT_LLM_ONE_CLICK_T4.ipynb
